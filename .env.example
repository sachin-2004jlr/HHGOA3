# ---- reverse image search -------------------------------------------------------
# Yandex reverse image search runs without any key. Add ONE of these to also query Google Lens:
# SerpApi Google Lens  - https://serpapi.com  (free tier: 100 searches/month)
SERPAPI_KEY=
# Serper.dev Google Lens - https://serper.dev (free credits on signup)
SERPER_API_KEY=
# auto | yandex | serpapi | serper
SEARCH_ENGINE=auto


# ---- face matching ------------------------------------------------------------
# SFace cosine threshold for "same person" (OpenCV recommends 0.363)
FACE_MATCH_THRESHOLD=0.363
MAX_CANDIDATES=60

# ---- blockchain ---------------------------------------------------------------
# auto = EVM node if reachable, else the simulated chain
# evm  = any EVM JSON-RPC (Anvil local node by default, or a public testnet)
# sim  = pure-python simulated chain stored in simchain.json (no node needed)
CHAIN_BACKEND=auto

# Local Anvil (default). For Ethereum Sepolia use a public endpoint, e.g.
#   RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#   RPC_URL=https://1rpc.io/sepolia
RPC_URL=http://127.0.0.1:8545

# Signer. Leave empty to use Anvil's pre-funded dev account #0.
# For a public testnet run `python scripts/new_wallet.py` and fund the address.
PRIVATE_KEY=

# Optional: override the registry address (otherwise read from deployments.json)
CONTRACT_ADDRESS=
